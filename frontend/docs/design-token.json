  "$description": "Source-grounded design token extraction from the user-supplied Color Design System SVG and Typography specimen Light/Dark SVG. Values not defined by the SVGs are intentionally not invented.",
  "$extensions": {
    "sources": [
      {
        "file": "design-system(1).svg",
        "viewBox": "0 0 1440 1240"
      },
      {
        "file": "typography-specimen-dark(1).svg",
        "viewBox": "0 0 1440 3950"
      }
    ],
    "application": "SaaS business tool",
    "language": [
      "vi",
      "Latin"
    ],
    "sourceRules": {
      "paletteShadeWeights": [
        100,
        300,
        500,
        700,
        900
      ],
      "neutral": "white and black separate pure grayscale scales",
      "typeScaleRatioDeclared": 1.25,
      "bodyM": "16px/24px",
      "textRendering": "optimizeLegibility",
      "fontLoading": "not embedded; must be installed or provided by environment"
    },
    "usageRules": {
      "do": [
        "Keep content lines approximately 45–75 characters",
        "Use at most three font weights per screen",
        "Use 16px/24px for dashboard body text"
      ],
      "dont": [
        "Do not uppercase long paragraphs",
        "Do not use text under 12px or reduce readability",
        "Do not use Lora as a monospace code font"
      ]
    },
    "notSpecified": {
      "spacingScale": "Not specified as a reusable scale (only specimen positioning is present)",
      "radiusScale": "Not specified as a universal scale; radius 5, 12, 20, and marker 3 observed in different specimens",
      "elevation": "No shadow token specified",
      "breakpoints": "No responsive breakpoint values specified",
      "motion": "No duration, easing or animation tokens specified",
      "opacityScale": "No general opacity scale (only 0.07 swatch outline opacity observed)",
      "zIndex": "No layering index tokens specified",
      "componentStates": "No complete hover, focus, disabled, active, pressed state matrix specified",
      "componentDimensions": "Only hierarchy/usage cards and some swatch dimensions observed; no universal component system",
      "darkGlobalTheme": "Only dark hierarchy card is specified; a complete app-wide dark theme is not specified",
      "fontVerification": "Source SVG does not embed fonts and does not independently verify installed files, Vietnamese coverage, glyph metrics or license",
      "typographyScaleRatio": "Specimen declares ratio 1.25, but several 12-14px functional styles are explicit exceptions; values preserved exactly",
      "fontRendering": "Typeface metrics are environment-dependent; SVG requests text-rendering optimizeLegibility"
    },
