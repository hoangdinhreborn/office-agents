# Root project environment file.
APP_NAME="Local Multi-Agent AI Assistant"
APP_ENV=development

# 01 Local LLM (Reinforcement Learning / Reasoning Model via Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_TIMEOUT=180.0

# Google Workspace Integration (Calendar & Gmail)
CALENDAR_PROVIDER=google  # "google" (Google Calendar API) or "local" (RFC-5545 .ics only)
CALENDAR_DEFAULT_REMINDER_MINUTES=30
CALENDAR_TIMEZONE=Asia/Ho_Chi_Minh

GOOGLE_CREDENTIALS_PATH=data/tokens/google_credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=data/tokens/google_calendar_token.json
GOOGLE_GMAIL_TOKEN_PATH=data/tokens/google_gmail_token.json
GMAIL_LABEL=INBOX
# 0 = random port (Desktop app client). For a "web" client set a fixed port and register http://localhost:<port>/
GOOGLE_OAUTH_PORT=0

# Tùy chọn: Khai báo trực tiếp Credentials & Refresh Token trong .env (không cần chép thư mục data/tokens/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_GMAIL_REFRESH_TOKEN=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Senders filter for Gmail & EML (comma separated; blank = allow all)
ALLOWED_SENDERS=

# Outbound Email Polling Daemon
EMAIL_POLL_INTERVAL_MINUTES=5

# PDF Processing Configuration
PDF_MAX_SIZE_MB=50
PDF_MAX_PAGES=1000
PDF_OCR_ENABLED=false

# Token Security Encryption (Optional master key; auto-generated if blank)
TOKEN_ENCRYPTION_KEY=

# Database Configuration
DATABASE_URL=sqlite:///./data/assistant.db
