# Root project environment file.
APP_NAME="deskhive-harness"
APP_ENV=development

# Local Ollama (optional; Docker connects to Ollama on the host)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_TIMEOUT=180.0

# Optional cloud/provider endpoint for a fresh database. Can also be set in the UI.
LLM_BASE_URL=
LLM_MODEL=
LLM_PROTOCOL=openai-chat
# Environment variable NAME only, e.g. CUSTOM_LLM_API_KEY.
LLM_API_KEY_ENV=
CUSTOM_LLM_API_KEY=

# Google Workspace Integration (Calendar & Gmail)
CALENDAR_PROVIDER=google  # "google" (Google Calendar API) or "local" (RFC-5545 .ics only)
CALENDAR_DEFAULT_REMINDER_MINUTES=30
CALENDAR_TIMEZONE=Asia/Ho_Chi_Minh

GOOGLE_CREDENTIALS_PATH=data/tokens/google_credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=data/tokens/google_calendar_token.json
GOOGLE_GMAIL_TOKEN_PATH=data/tokens/google_gmail_token.json
GMAIL_LABEL=INBOX
# Legacy Python login script: 0 = random Desktop callback port.
GOOGLE_OAUTH_PORT=0
# Browser login: register this callback for a Google Web OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_OAUTH_FRONTEND_URL=http://localhost:3000

# Tùy chọn: Khai báo trực tiếp Credentials & Refresh Token trong .env (không cần chép thư mục data/tokens/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_GMAIL_REFRESH_TOKEN=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Senders filter for Gmail & EML (comma separated; blank = allow all)
ALLOWED_SENDERS=

# Outbound Email Polling Daemon
EMAIL_POLL_INTERVAL_MINUTES=5

# PDF Processing Configuration
PDF_MAX_SIZE_MB=50
PDF_MAX_PAGES=1000
PDF_OCR_ENABLED=false

# Token Security Encryption (Optional master key; auto-generated if blank)
TOKEN_ENCRYPTION_KEY=

# Database Configuration
DATABASE_URL=sqlite:///./data/assistant.db
